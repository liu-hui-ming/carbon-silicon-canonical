+# G12/G13/G14: deep checks via subprocess (deepcheck_r36.sh -> deepcheck_parse.py)
+# Read-only CSV (quote-safe) parsing; exit 0=PASS 1=FAIL 2=SKIP.
+DEEPCHECK="$(dirname "${BASH_SOURCE[0]}")/deepcheck_r36.sh"
+deep_gate() { # gate_no base_dir
+  local g="$1" base="$2" out rc
+  if [[ ! -x "$DEEPCHECK" && ! -f "$DEEPCHECK" ]]; then
+    report "$g" SKIP "deepcheck_r36.sh not found"
+    return 0
   fi
-fi
+  out=$(bash "$DEEPCHECK" "G$g" "$base" 2>&1); rc=$?
+  case $rc in
+    0) report "$g" PASS "$(echo "$out" | head -1 | sed 's/^G[0-9]* PASS: //')" ;;
+    2) report "$g" SKIP "$(echo "$out" | head -1 | sed 's/^G[0-9]* SKIP: //')" ;;
+    *) for line in $(echo "$out" | grep '^\[detail\]' | head -3 | tr ' ' '\001'); do
+         printf '       %s\n' "$(echo "$line" | tr '\001' ' ')"
+       done
+       report "$g" FAIL "$(echo "$out" | head -1 | sed 's/^G[0-9]* FAIL: //')" ;;
+  esac
+}
 
